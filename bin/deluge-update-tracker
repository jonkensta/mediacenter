#!/config/venv/bin/python3
"""
Force a tracker re-announce for torrents by hash.
Reads torrent hashes from stdin, one per line.

Intended to run inside the deluge container:
  docker exec -i deluge deluge-update-tracker

Examples:
  # Re-announce a specific torrent
  echo <hash> | docker exec -i deluge deluge-update-tracker

  # Re-announce all timed-out torrents. Filter on the tracker_status COLUMN so a
  # release whose name happens to contain the phrase is not swept up.
  docker exec deluge deluge-list-torrents \
    | awk -F'\t' '$6 ~ /timed out/' \
    | cut -f1 \
    | docker exec -i deluge deluge-update-tracker
"""

import re
import sys

try:
    from deluge_client import DelugeRPCClient
except ImportError:
    print("Error: deluge-client not installed. Run: pip install deluge-client", file=sys.stderr)
    sys.exit(1)

AUTH_FILE = "/config/auth"
HOST = "127.0.0.1"
PORT = 58846

HASH_RE = re.compile(r"^[0-9a-fA-F]{40}$")


def read_localclient_password(auth_file):
    with open(auth_file) as f:
        for line in f:
            line = line.strip()
            if line.startswith("localclient:"):
                return line.split(":")[1]
    raise RuntimeError(f"localclient entry not found in {auth_file}")


def read_hashes():
    """Read hashes from stdin, rejecting anything that is not a torrent hash."""
    hashes, bad = [], []
    for line in sys.stdin:
        entry = line.strip()
        if not entry:
            continue
        # Tolerate a full TSV row being piped in by accident.
        entry = entry.split("\t")[0]
        (hashes if HASH_RE.match(entry) else bad).append(entry)

    if bad:
        print(f"Error: {len(bad)} input line(s) are not 40-char torrent hashes:", file=sys.stderr)
        for entry in bad[:10]:
            print(f"  {entry!r}", file=sys.stderr)
        sys.exit(1)

    return list(dict.fromkeys(h.lower() for h in hashes))


def main():
    hashes = read_hashes()
    if not hashes:
        print("No hashes provided on stdin.", file=sys.stderr)
        sys.exit(1)

    password = read_localclient_password(AUTH_FILE)
    client = DelugeRPCClient(HOST, PORT, "localclient", password)
    client.connect()

    try:
        client.core.force_reannounce(hashes)
    finally:
        client.disconnect()

    for torrent_hash in hashes:
        print(f"Updated: {torrent_hash}")


if __name__ == "__main__":
    main()
