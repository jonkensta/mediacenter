#!/config/venv/bin/python3
"""
Remove torrents from Deluge by hash, along with their data files.
Reads torrent hashes from stdin, one per line.

This deletes data irreversibly, so it validates every hash up front, shows what
it is about to remove, and requires confirmation unless --yes is given.

Intended to run inside the deluge container:
  docker exec -i deluge deluge-remove-torrent

Requires the deluge-client package:
  pip install deluge-client

Examples:
  # Remove a specific torrent by hash (prompts for confirmation)
  echo <hash> | docker exec -i deluge deluge-remove-torrent

  # Preview without removing anything
  echo <hash> | docker exec -i deluge deluge-remove-torrent --dry-run

  # Remove unregistered torrents. Filter on the tracker_status COLUMN: matching
  # the whole line would also match a release named "Not.Registered.2024".
  docker exec deluge deluge-list-torrents \
    | awk -F'\t' '$6 ~ /not registered/' \
    | cut -f1 \
    | docker exec -i deluge deluge-remove-torrent --yes

  # Interactive removal with fzf (multi-select with tab)
  docker exec deluge deluge-list-torrents \
    | fzf -m --with-nth=2.. \
    | cut -f1 \
    | docker exec -i deluge deluge-remove-torrent --yes

Note: stdin carries the hash list, so there is no terminal left to prompt on.
Piped invocations must pass --yes (use --dry-run first to check the selection).
"""

import argparse
import re
import sys

try:
    from deluge_client import DelugeRPCClient
except ImportError:
    print("Error: deluge-client not installed. Run: pip install deluge-client", file=sys.stderr)
    sys.exit(1)

AUTH_FILE = "/config/auth"
HOST = "127.0.0.1"
PORT = 58846

HASH_RE = re.compile(r"^[0-9a-fA-F]{40}$")


def read_localclient_password(auth_file):
    with open(auth_file) as f:
        for line in f:
            line = line.strip()
            if line.startswith("localclient:"):
                return line.split(":")[1]
    raise RuntimeError(f"localclient entry not found in {auth_file}")


def read_hashes():
    """Read hashes from stdin, rejecting anything that is not a torrent hash."""
    hashes, bad = [], []
    for line in sys.stdin:
        entry = line.strip()
        if not entry:
            continue
        # Tolerate a full TSV row being piped in by accident.
        entry = entry.split("\t")[0]
        (hashes if HASH_RE.match(entry) else bad).append(entry)

    if bad:
        print(f"Error: {len(bad)} input line(s) are not 40-char torrent hashes:", file=sys.stderr)
        for entry in bad[:10]:
            print(f"  {entry!r}", file=sys.stderr)
        print("Refusing to remove anything.", file=sys.stderr)
        sys.exit(1)

    # Preserve order, drop duplicates.
    return list(dict.fromkeys(h.lower() for h in hashes))


def main():
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--yes", action="store_true", help="Skip the confirmation prompt")
    parser.add_argument(
        "--dry-run", action="store_true", help="Show what would be removed and exit"
    )
    args = parser.parse_args()

    hashes = read_hashes()
    if not hashes:
        print("No hashes provided on stdin.", file=sys.stderr)
        sys.exit(1)

    password = read_localclient_password(AUTH_FILE)
    client = DelugeRPCClient(HOST, PORT, "localclient", password)
    client.connect()

    try:
        status = client.core.get_torrents_status({"id": hashes}, ["name"])
        names = {
            tid.decode(): info.get(b"name", b"").decode(errors="replace")
            for tid, info in status.items()
        }

        unknown = [h for h in hashes if h not in names]
        if unknown:
            print(f"Error: {len(unknown)} hash(es) not found in Deluge:", file=sys.stderr)
            for entry in unknown[:10]:
                print(f"  {entry}", file=sys.stderr)
            print("Refusing to remove anything.", file=sys.stderr)
            sys.exit(1)

        print(f"About to remove {len(hashes)} torrent(s) AND their data:", file=sys.stderr)
        for torrent_hash in hashes:
            print(f"  {torrent_hash}  {names[torrent_hash]}", file=sys.stderr)

        if args.dry_run:
            print("Dry run; nothing removed.", file=sys.stderr)
            return

        if not args.yes:
            if not sys.stdin.isatty():
                # stdin is the hash list, so there is no way to prompt safely.
                print(
                    "Refusing to remove without confirmation. Re-run with --yes "
                    "(or --dry-run to preview).",
                    file=sys.stderr,
                )
                sys.exit(1)
            if input("Type 'yes' to continue: ").strip().lower() != "yes":
                print("Aborted.", file=sys.stderr)
                sys.exit(1)

        failures = []
        for torrent_hash in hashes:
            try:
                # remove_torrent returns False when the daemon declines.
                if client.core.remove_torrent(torrent_hash, True):  # True = delete data
                    print(f"Removed: {torrent_hash}  {names[torrent_hash]}")
                else:
                    failures.append((torrent_hash, "daemon refused the removal"))
            except Exception as error:  # pylint: disable=broad-except
                failures.append((torrent_hash, str(error)))

        if failures:
            print(f"\n{len(failures)} failure(s):", file=sys.stderr)
            for torrent_hash, error in failures:
                print(f"  {torrent_hash}: {error}", file=sys.stderr)
            sys.exit(1)
    finally:
        client.disconnect()


if __name__ == "__main__":
    main()
