#!/usr/bin/env python3
"""Rebalance mergerfs branches by moving hardlink-closed groups of files.

Moves whole top-level items (Movies/<dir>, TV/<dir>, Downloads/<item>, ...)
from over-full source branches to a target branch until every branch sits at
roughly the same percent-used. Items connected by hardlinks are moved together
in a single `rsync -aHAX` run so links, ACLs, and xattrs survive the move;
groups whose links cannot be fully accounted for are never touched.

Run with the mediaserver stack stopped so branches are quiescent. Must run as
root (source trees are not group-writable); rsync -a preserves media:media
ownership so no chown pass is needed afterwards.

Safety behaviour:
- Dry-run by default; --execute to actually move.
- A group is skipped if any of its multi-link inodes has links outside the
  scanned top dirs (deleting the moved paths would leave a hidden copy).
- A group is skipped if any of its items already exists on the target branch
  (never merge/overwrite silently).
- After each rsync, a no-op verify pass (`rsync -aHAXn`) must report nothing to
  transfer before any source file is deleted.
- Free space on the target is checked before each group.
"""

import argparse
import os
import shutil
import stat
import subprocess
import sys
import time

TOP_DIRS = ("Movies", "TV", "Downloads", "Music")


def log(msg):
    print(msg, flush=True)


def fail(msg):
    print(f"ERROR: {msg}", file=sys.stderr, flush=True)
    sys.exit(1)


def walk_error(error):
    # Safety depends on COMPLETE enumeration: a silently pruned subtree could
    # hide a collision or a hardlink group member, so abort instead.
    fail(f"cannot read {error.filename}: {error}")


class Item:
    """One movable top-level item, e.g. Movies/Foo (dir) or Downloads/x.mkv."""

    def __init__(self, rel):
        self.rel = rel            # path relative to branch root
        self.single_bytes = 0     # bytes in files with st_nlink == 1
        self.multi_inodes = set() # inodes of files with st_nlink > 1


def scan_branch(branch):
    """Walk one branch; return (items{rel: Item}, inode -> (size, nlink, [item rels]))."""
    items = {}
    inodes = {}
    for top in TOP_DIRS:
        top_path = os.path.join(branch, top)
        if not os.path.isdir(top_path):
            continue
        for entry in os.scandir(top_path):
            rel = f"{top}/{entry.name}"
            item = items[rel] = Item(rel)
            if entry.is_file(follow_symlinks=False):
                st = entry.stat(follow_symlinks=False)
                record_file(item, inodes, st)
                continue
            if not entry.is_dir(follow_symlinks=False):
                continue
            for root, _dirs, files in os.walk(entry.path, onerror=walk_error):
                for name in files:
                    try:
                        st = os.lstat(os.path.join(root, name))
                    except FileNotFoundError:
                        continue
                    if not os.path.isfile(os.path.join(root, name)):
                        continue
                    record_file(item, inodes, st)
    return items, inodes


def record_file(item, inodes, st):
    if st.st_nlink > 1:
        item.multi_inodes.add(st.st_ino)
        size, nlink, rels = inodes.setdefault(st.st_ino, (st.st_size, st.st_nlink, []))
        rels.append(item.rel)
    else:
        item.single_bytes += st.st_size


def build_groups(items, inodes):
    """Union items sharing inodes. Returns list of (item rels, freed_bytes, movable)."""
    parent = {rel: rel for rel in items}

    def find(x):
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x

    def union(a, b):
        ra, rb = find(a), find(b)
        if ra != rb:
            parent[ra] = rb

    unaccounted = set()  # inodes with links we did not observe
    for ino, (_size, nlink, rels) in inodes.items():
        for rel in rels[1:]:
            union(rels[0], rel)
        if len(rels) != nlink:
            unaccounted.add(ino)

    groups = {}
    for rel in items:
        groups.setdefault(find(rel), []).append(rel)

    result = []
    for rels in groups.values():
        freed = sum(items[r].single_bytes for r in rels)
        group_inodes = set().union(*(items[r].multi_inodes for r in rels))
        freed += sum(inodes[i][0] for i in group_inodes)
        movable = not (group_inodes & unaccounted)
        result.append((sorted(rels), freed, movable))
    return result


def pick_groups(groups, quota):
    """Greedy: largest movable groups first until quota is met."""
    chosen, total = [], 0
    for rels, freed, movable in sorted(groups, key=lambda g: -g[1]):
        if not movable:
            continue
        if total >= quota:
            break
        if total + freed > quota * 1.10 and freed > quota * 0.10:
            continue  # would overshoot badly; try smaller groups
        chosen.append((rels, freed))
        total += freed
    return chosen, total


def target_free_bytes(target):
    st = os.statvfs(target)
    return st.f_bavail * st.f_frsize


def item_size(item, inodes):
    return item.single_bytes + sum(inodes[i][0] for i in item.multi_inodes)


FAST_EDGE = 4 * 1024 * 1024      # bytes compared at each end of the file
FAST_BLOCK = 1024 * 1024         # interior sample block size
FAST_SAMPLES = 16                # number of interior sample blocks


def sampled_identical(first, second, size):
    """Sampled equality check: head, tail, and evenly spaced interior blocks.

    Reads ~24MB per file regardless of size; small files are compared in
    full. Callers must have already established equal sizes. Not proof - but
    the consolidate collision path only compares files that already match on
    branch-relative path, name, AND size, where a genuine mismatch is
    vanishingly rare; sampling is the cheap insurance against a same-size
    copy corrupted by an interrupted write.
    """
    small = size <= 2 * FAST_EDGE + FAST_SAMPLES * FAST_BLOCK
    if small:
        offsets, lengths = [0], [size]
    else:
        span = size - 2 * FAST_EDGE - FAST_BLOCK
        offsets = [0, size - FAST_EDGE]
        lengths = [FAST_EDGE, FAST_EDGE]
        for i in range(FAST_SAMPLES):
            offsets.append(FAST_EDGE + span * i // (FAST_SAMPLES - 1))
            lengths.append(FAST_BLOCK)
    with open(first, "rb") as f1, open(second, "rb") as f2:
        for offset, length in zip(offsets, lengths):
            f1.seek(offset)
            f2.seek(offset)
            while length > 0:
                chunk = min(length, 8 * 1024 * 1024)
                if f1.read(chunk) != f2.read(chunk):
                    return False
                length -= chunk
    return True


def entry_kind(st_mode):
    if stat.S_ISDIR(st_mode):
        return "dir"
    if stat.S_ISREG(st_mode):
        return "reg"
    return "other"  # symlink, fifo, device, socket


def item_entries(branch, rel):
    """Yield (branch-relative path, kind) for every entry under one item -
    directories, symlinks and special files included, so any type-mismatched
    collision on the home branch is detected instead of being silently
    dropped by --ignore-existing."""
    base = os.path.join(branch, rel)
    yield rel, entry_kind(os.lstat(base).st_mode)
    if not os.path.isdir(base) or os.path.islink(base):
        return
    for root, dirs, files in os.walk(base, onerror=walk_error):
        # symlinks to directories appear in dirs but are not descended into
        for name in dirs + files:
            full = os.path.join(root, name)
            yield os.path.relpath(full, branch), entry_kind(os.lstat(full).st_mode)


def consolidate(branches, execute):
    """Merge items that exist on multiple branches onto a single home branch.

    Home is the branch holding the most bytes of the item. Fragments move as
    hardlink-closed groups. A file colliding with an identical copy on the
    home branch is simply dropped from the source (that IS the stale-duplicate
    cleanup); a collision with different content skips the whole group.
    """
    scans = {}
    for b in branches:
        log(f"scanning {b} ...")
        items, inodes = scan_branch(b)
        groups = build_groups(items, inodes)
        index = {}
        for g in groups:
            for rel in g[0]:
                index[rel] = g
        scans[b] = (items, inodes, index)

    presence = {}
    for b in branches:
        for rel in scans[b][0]:
            presence.setdefault(rel, []).append(b)
    multi = {rel: bs for rel, bs in presence.items() if len(bs) > 1}
    log(f"{len(multi)} item(s) present on more than one branch")

    processed = set()
    moved_total = 0
    skips = 0        # conflicts / pinned links: re-running will NOT fix these
    stale_skips = 0  # in-run snapshot staleness: a fresh run WILL fix these
    for rel in sorted(multi):
        holders = multi[rel]
        sizes = {b: item_size(scans[b][0][rel], scans[b][1]) for b in holders}
        home = max(holders, key=lambda b: sizes[b])
        for src in holders:
            if src == home:
                continue
            # An earlier group move this run may already have relocated this
            # item or its home copy; trust the disk over the startup snapshot,
            # or we could "heal" a fragment back onto a branch the item just
            # left - re-splitting it.
            if not os.path.lexists(os.path.join(src, rel)):
                continue
            if not os.path.lexists(os.path.join(home, rel)):
                log(f"SKIP {src}/{rel}: home copy on {home} moved during this "
                    f"run - re-run --consolidate to finish")
                stale_skips += 1
                continue
            rels, freed, movable = scans[src][2][rel]
            key = (src, tuple(rels))
            if key in processed:
                continue
            processed.add(key)
            if not movable:
                log(f"SKIP {src}/{rel}: group pinned by links outside scanned dirs")
                skips += 1
                continue

            conflict = None
            identical_bytes = 0
            for item_rel in rels:
                for f, kind in item_entries(src, item_rel):
                    home_path = os.path.join(home, f)
                    if not os.path.lexists(home_path):
                        continue
                    if kind == "dir":
                        # directories merge, but only into a real directory
                        if os.path.isdir(home_path) and not os.path.islink(home_path):
                            continue
                        conflict = f
                        break
                    # A collision is droppable only when BOTH sides are plain
                    # regular files that match on size and a sampled compare.
                    # Same rel path + name + size already makes a mismatch
                    # vanishingly rare; sampling (~24MB/file) is deliberate,
                    # accepted insurance in place of a full compare.
                    if kind != "reg":
                        conflict = f
                        break
                    src_path = os.path.join(src, f)
                    src_size = os.lstat(src_path).st_size
                    if not os.path.isfile(home_path) or os.path.islink(home_path):
                        conflict = f
                        break
                    if os.lstat(home_path).st_size != src_size or \
                            not sampled_identical(src_path, home_path, src_size):
                        conflict = f
                        break
                    identical_bytes += src_size
                if conflict:
                    break
            if conflict:
                log(f"SKIP {src}/{rel} -> {home}: conflicting copy of {conflict}")
                skips += 1
                continue

            note = f" ({identical_bytes/2**30:.1f}G duplicate, dropped)" if identical_bytes else ""
            log(f"{'moving' if execute else 'would move'} "
                f"{src} -> {home}: {', '.join(rels)} [{freed/2**30:.1f}G]{note}")
            moved_total += freed
            if not execute:
                continue

            if target_free_bytes(home) < freed + 50 * 2**30:
                fail(f"{home} would drop below 50G free; aborting")
            sources = [os.path.join(src, ".", r) for r in rels]
            subprocess.run(
                ["rsync", "-aHAX", "--relative", "--ignore-existing", *sources, home + "/"],
                check=True)
            verify = subprocess.run(
                ["rsync", "-aHAXn", "--relative", "--ignore-existing",
                 "--itemize-changes", *sources, home + "/"],
                capture_output=True, text=True, check=True)
            diffs = [l for l in verify.stdout.splitlines()
                     if l and not l.startswith("cd") and not l.startswith(".d")]
            if diffs:
                fail(f"verify pass shows differences after rsync of {rels}: {diffs[:5]}")
            for r in rels:
                p = os.path.join(src, r)
                if os.path.isdir(p) and not os.path.islink(p):
                    shutil.rmtree(p)
                else:
                    os.remove(p)

    verb = "moved" if execute else "would move"
    log(f"consolidation done: {verb} {moved_total/2**30:.0f}G between branches")
    log("note: colliding hardlinks may have been split across inodes; "
        "run mergerfs-hardlink-downloads afterwards to re-link")
    if stale_skips:
        log(f"note: {stale_skips} group move(s) deferred by in-run state "
            f"changes - re-run --consolidate to finish them")
    if skips:
        log(f"WARNING: {skips} group move(s) skipped - these items are still "
            f"split; re-running will not fix conflicts or pinned links "
            f"(resolve those manually)")
        sys.exit(2)


def move_group(branch, target, rels, freed, execute):
    sources = [os.path.join(branch, ".", rel) for rel in rels]
    for rel in rels:
        dest = os.path.join(target, rel)
        if os.path.lexists(dest):
            log(f"  SKIP group: target already has {dest}")
            return 0
    if not execute:
        for rel in rels:
            log(f"  would move {branch}/{rel}")
        return freed

    if target_free_bytes(target) < freed + 50 * 2**30:
        fail(f"target {target} would drop below 50G free; aborting")

    t0 = time.monotonic()
    subprocess.run(["rsync", "-aHAX", "--relative", *sources, target + "/"], check=True)
    verify = subprocess.run(
        ["rsync", "-aHAXn", "--relative", "--itemize-changes", *sources, target + "/"],
        capture_output=True, text=True, check=True)
    # Directory-only lines (mtime touch-ups) are harmless; any file line is not.
    diffs = [l for l in verify.stdout.splitlines() if l and not l.startswith("cd") and not l.startswith(".d")]
    if diffs:
        fail(f"verify pass shows differences after rsync of {rels}: {diffs[:5]}")

    for rel in rels:
        src = os.path.join(branch, rel)
        if os.path.isdir(src) and not os.path.islink(src):
            shutil.rmtree(src)
        else:
            os.remove(src)
    dt = time.monotonic() - t0
    log(f"  moved {freed/2**30:.1f}G in {dt/60:.1f}min ({freed/2**20/max(dt,1):.0f} MB/s)")
    return freed


def branch_usage(path):
    st = os.statvfs(path)
    size = st.f_blocks * st.f_frsize
    used = (st.f_blocks - st.f_bfree) * st.f_frsize
    return size, used


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--target", help="branch to move data onto (rebalance mode)")
    ap.add_argument("--sources", nargs="+", required=True, help="branches to shed data from")
    ap.add_argument("--execute", action="store_true", help="actually move (default: dry-run)")
    ap.add_argument("--consolidate", action="store_true",
                    help="instead of leveling fill, merge items split across "
                    "branches onto one branch each (--sources is the full branch list)")
    args = ap.parse_args()
    if not args.consolidate and not args.target:
        ap.error("--target is required unless --consolidate is given")

    if args.execute and os.geteuid() != 0:
        fail("--execute requires root")
    if args.execute:
        state = subprocess.run(["systemctl", "is-active", "--quiet", "mediaserver.service"])
        if state.returncode == 0:
            fail("mediaserver.service is active; stop it first")
        if os.path.ismount("/mnt/merged"):
            fail("/mnt/merged is mounted; stop mergerfs.service first")

    branches = args.sources + ([args.target] if args.target else [])
    for b in branches:
        if not os.path.ismount(b):
            fail(f"{b} is not a mountpoint")

    if args.consolidate:
        consolidate(branches, args.execute)
        return

    total_size = total_used = 0
    for b in branches:
        size, used = branch_usage(b)
        total_size += size
        total_used += used
    target_pct = total_used / total_size
    log(f"pool: {total_used/2**40:.2f}T used of {total_size/2**40:.2f}T "
        f"-> target {target_pct*100:.1f}% per branch")

    grand_total = 0
    for branch in args.sources:
        size, used = branch_usage(branch)
        quota = used - target_pct * size
        if quota < 10 * 2**30:
            log(f"{branch}: at {used/size*100:.1f}%, within 10G of target - nothing to do")
            continue
        log(f"{branch}: {used/size*100:.1f}% used, shedding {quota/2**30:.0f}G ...")
        items, inodes = scan_branch(branch)
        groups = build_groups(items, inodes)
        skipped = sum(1 for _r, _f, m in groups if not m)
        if skipped:
            log(f"  ({skipped} groups pinned by links outside {'/'.join(TOP_DIRS)})")
        chosen, total = pick_groups(groups, quota)
        log(f"  plan: {len(chosen)} groups, {total/2**30:.0f}G")
        moved = 0
        for rels, freed in chosen:
            moved += move_group(branch, args.target, rels, freed, args.execute)
        verb = "moved" if args.execute else "would move"
        log(f"{branch}: {verb} {moved/2**30:.0f}G")
        grand_total += moved

    verb = "moved" if args.execute else "would move"
    log(f"done: {verb} {grand_total/2**30:.0f}G total to {args.target}")


if __name__ == "__main__":
    main()
