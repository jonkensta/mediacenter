#!/usr/bin/env python3
"""
Find duplicate files between the Downloads directory and the media library
(Movies/TV) on a mergerfs pool, and replace the media copy with a hardlink
to the Downloads copy so both paths share a single copy on disk.

Candidates are matched by size and then verified byte-for-byte before any
file is touched. Files that are already the same inode are skipped.

Both paths must be on the same underlying branch for a hardlink to work.
If they are on different branches, the media file is moved to the downloads
branch first, then hardlinked.

Usage:
  mergerfs-hardlink-downloads              # dry-run (default, safe)
  mergerfs-hardlink-downloads --execute    # actually make changes
  mergerfs-hardlink-downloads --clean-tmp  # remove leftover .hlnk_tmp files

The media server must be stopped before running with --execute; the script
enforces this unless --force is given.
"""

import argparse
import filecmp
import os
import stat
import subprocess
import sys
import time

MERGED = "/mnt/merged"
DOWNLOADS = os.path.join(MERGED, "Downloads")
MEDIA_DIRS = [os.path.join(MERGED, "Movies"), os.path.join(MERGED, "TV")]
MIN_SIZE = 100 * 1024 * 1024  # ignore files smaller than 100MB
TMP_SUFFIX = ".hlnk_tmp"
SERVICE = "mediaserver.service"

WARNINGS = 0


def warn(message):
    """Print a warning and count it; any warning makes the run exit non-zero
    so a 'clean' report can be trusted to have actually seen every file."""
    global WARNINGS
    WARNINGS += 1
    print(f"Warning: {message}", file=sys.stderr)


def discover_branches():
    """Return the pool's branches from mergerfs' own srcmounts.

    This is authoritative and there is deliberately no glob fallback: guessing
    (e.g. /mnt/0[0-7]) can include stale directories that are not branches at
    all, and every safety check downstream depends on this list being right.
    """
    try:
        # Runtime config xattrs live on the hidden control file, not the root.
        raw = os.getxattr(os.path.join(MERGED, ".mergerfs"), b"user.mergerfs.srcmounts").decode()
    except OSError as error:
        sys.exit(
            f"Cannot read mergerfs srcmounts from {MERGED}/.mergerfs: {error}\n"
            f"Is {MERGED} mounted? (systemctl start mergerfs.service)"
        )
    branches = [b for b in raw.split(":") if b]
    if not branches:
        sys.exit(f"mergerfs srcmounts on {MERGED} is empty; refusing to guess.")
    return branches


def relative_to_merged(merged_path):
    """Return merged_path relative to the pool root, refusing anything outside it."""
    prefix = MERGED + os.sep
    if not merged_path.startswith(prefix):
        raise ValueError(f"{merged_path} is not under {MERGED}")
    return merged_path[len(prefix):]


def find_branches(merged_path, branches):
    """Return every branch holding merged_path, in mergerfs search order."""
    relative = relative_to_merged(merged_path)
    return [b for b in branches if os.path.lexists(os.path.join(b, relative))]


def branch_path(merged_path, branch):
    """Map a merged path onto a specific branch."""
    return os.path.join(branch, relative_to_merged(merged_path))


def scan(path):
    """Group files under path by size, ignoring small files and temp artifacts.

    Returns (by_size, inodes) where inodes is the set of (st_dev, st_ino) of
    every file recorded in by_size.
    """
    by_size = {}
    inodes = set()

    def on_error(error):
        warn(f"cannot read {error.filename}: {error}")

    for dirpath, _, filenames in os.walk(path, onerror=on_error):
        for name in filenames:
            if name.endswith(TMP_SUFFIX):
                continue
            filepath = os.path.join(dirpath, name)
            try:
                st = os.lstat(filepath)
            except OSError as error:
                warn(f"cannot stat {filepath}: {error}")
                continue
            if not stat.S_ISREG(st.st_mode):
                continue  # a symlink is not a hardlink; never count or link one
            if st.st_size >= MIN_SIZE:
                by_size.setdefault(st.st_size, []).append(filepath)
                inodes.add((st.st_dev, st.st_ino))
    return by_size, inodes


def find_stale_tmp_files(branches):
    """Return leftover .hlnk_tmp files from an interrupted run."""
    stale = []

    def on_error(error):
        warn(f"cannot read {error.filename}: {error}")

    for branch in branches:
        for media_dir in MEDIA_DIRS:
            root = os.path.join(branch, relative_to_merged(media_dir))
            if not os.path.isdir(root):
                continue
            for dirpath, _, filenames in os.walk(root, onerror=on_error):
                stale.extend(
                    os.path.join(dirpath, name)
                    for name in filenames
                    if name.endswith(TMP_SUFFIX)
                )
    return stale


def mediaserver_is_running():
    """Return True if the media server unit is active."""
    try:
        result = subprocess.run(
            ["systemctl", "is-active", "--quiet", SERVICE],
            check=False,
        )
    except OSError:
        return False
    return result.returncode == 0


def same_content(first, second):
    """Return True if two files hold identical bytes (short-circuits on the first diff)."""
    return filecmp.cmp(first, second, shallow=False)


FAST_EDGE = 4 * 1024 * 1024      # bytes compared at each end of the file
FAST_BLOCK = 1024 * 1024         # interior sample block size
FAST_SAMPLES = 16                # number of interior sample blocks


def sampled_same_content(first, second, size):
    """Probabilistic equality: compare head, tail, and evenly spaced interior blocks.

    Reads ~24MB per file regardless of size. Two different media files of
    identical size will essentially always differ in these regions, but this
    is not proof - a file differing only inside an unsampled window would be
    missed. Small files are compared in full.
    """
    if size <= 2 * FAST_EDGE + FAST_SAMPLES * FAST_BLOCK:
        return same_content(first, second)
    span = size - 2 * FAST_EDGE - FAST_BLOCK
    offsets = [0, size - FAST_EDGE]
    lengths = [FAST_EDGE, FAST_EDGE]
    for i in range(FAST_SAMPLES):
        offsets.append(FAST_EDGE + span * i // (FAST_SAMPLES - 1))
        lengths.append(FAST_BLOCK)
    with open(first, "rb") as f1, open(second, "rb") as f2:
        for offset, length in zip(offsets, lengths):
            f1.seek(offset)
            f2.seek(offset)
            if f1.read(length) != f2.read(length):
                return False
    return True


def match_pairs(downloads_by_size, media_by_size, compare_fn, downloads_inodes,
                branches):
    """Pair each media file with at most one content-identical download.

    Media files whose (st_dev, st_ino) is already in downloads_inodes are
    correctly hardlinked to a Downloads copy and are skipped without reading
    a single byte; they are counted in the returned already_linked total.
    A linked file whose path still exists on more than one branch (the stale
    leftover of an interrupted cross-branch run) is NOT counted as done - it
    is warned about instead, so it can't hide behind the fast path.
    """
    pairs = []
    skipped_no_match = 0
    already_linked = 0
    comparisons = 0
    duplicate_bytes = 0
    last_report = time.monotonic()

    for size, media_paths in sorted(media_by_size.items()):
        candidates = downloads_by_size.get(size)
        if not candidates:
            continue

        for media_path in media_paths:
            try:
                st = os.stat(media_path)
            except OSError as error:
                warn(f"cannot stat {media_path}: {error}")
                continue
            if (st.st_dev, st.st_ino) in downloads_inodes:
                if len(find_branches(media_path, branches)) > 1:
                    warn(f"{media_path} is hardlinked to Downloads but exists "
                         f"on more than one branch (interrupted run?) - run "
                         f"rebalance-branches --consolidate to drop the stale copy")
                else:
                    already_linked += 1
                continue
            chosen = None
            for candidate in candidates:
                try:
                    if compare_fn:
                        identical = compare_fn(candidate, media_path, size)
                        comparisons += 1
                        if identical:
                            duplicate_bytes += size
                        if time.monotonic() - last_report > 60:
                            print(
                                f"progress: {comparisons} comparison(s), "
                                f"{len(pairs)} duplicate(s) "
                                f"({duplicate_bytes / 1e9:.0f} GB) so far",
                                flush=True,
                            )
                            last_report = time.monotonic()
                        if not identical:
                            continue
                except OSError as error:
                    warn(f"cannot compare {candidate} and {media_path}: {error}")
                    continue
                chosen = candidate
                break

            if chosen is None:
                skipped_no_match += 1
                continue
            pairs.append((size, chosen, media_path))

    return pairs, skipped_no_match, already_linked


def link_same_branch(source, target):
    """Replace target with a hardlink to source via an atomic rename."""
    tmp = target + TMP_SUFFIX
    if os.path.lexists(tmp):
        raise RuntimeError(f"stale temp file {tmp} (run --clean-tmp)")
    os.link(source, tmp)
    try:
        if not os.path.samefile(source, tmp):
            raise RuntimeError(f"link verification failed for {tmp}")
        os.rename(tmp, target)
    except Exception:
        # Leave the original target untouched.
        try:
            os.remove(tmp)
        except OSError:
            pass
        raise


def link_across_branches(source, target, old_copy):
    """Hardlink source onto the downloads branch, then drop the old branch copy."""
    if os.path.lexists(target):
        raise RuntimeError(f"{target} already exists on the target branch")
    os.makedirs(os.path.dirname(target), exist_ok=True)
    os.link(source, target)
    if not os.path.samefile(source, target):
        os.remove(target)
        raise RuntimeError(f"link verification failed for {target}")
    os.remove(old_copy)


def main():
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--execute", action="store_true", help="Apply changes (default is dry-run)"
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help=f"Skip the {SERVICE} running check (dangerous)",
    )
    parser.add_argument(
        "--no-verify",
        action="store_true",
        help="Match on size alone without comparing contents (dangerous)",
    )
    parser.add_argument(
        "--fast-verify",
        action="store_true",
        help="Compare head, tail, and sampled interior blocks (~24MB/file) "
        "instead of every byte. Fast and near-certain, but not proof.",
    )
    parser.add_argument(
        "--clean-tmp",
        action="store_true",
        help=f"Delete leftover *{TMP_SUFFIX} files and exit",
    )
    args = parser.parse_args()

    dry_run = not args.execute
    if args.no_verify:
        compare_fn = None
    elif args.fast_verify:
        compare_fn = sampled_same_content
    else:
        compare_fn = lambda first, second, _size: same_content(first, second)
    branches = discover_branches()

    if args.clean_tmp:
        stale = find_stale_tmp_files(branches)
        for path in stale:
            print(f"Removing {path}")
            os.remove(path)
        print(f"Removed {len(stale)} temp file(s).")
        if WARNINGS:
            sys.exit(f"{WARNINGS} warning(s) - some directories were unreadable, "
                     f"so more temp files may remain.")
        return

    if args.execute and not args.force and mediaserver_is_running():
        sys.exit(
            f"Refusing to run: {SERVICE} is active. Files may be written while\n"
            f"this script works, which can hardlink a partial file over a good\n"
            f"library copy. Stop it first:\n"
            f"  sudo systemctl stop {SERVICE}\n"
            f"Use --force to override."
        )

    stale = find_stale_tmp_files(branches)
    if stale:
        sys.exit(
            f"Found {len(stale)} leftover temp file(s) from an interrupted run.\n"
            f"Inspect them, then re-run with --clean-tmp:\n  "
            + "\n  ".join(stale[:10])
        )

    if dry_run:
        print("DRY-RUN mode — no changes will be made. Pass --execute to apply.\n")
    if args.no_verify:
        print("WARNING: --no-verify — matching on size alone. This can destroy files.\n")
    elif args.fast_verify:
        print("Fast verify: sampling ~24MB per file instead of full compare.\n")

    print("Scanning Downloads...", flush=True)
    downloads_by_size, downloads_inodes = scan(DOWNLOADS)

    print("Scanning Movies and TV...", flush=True)
    media_by_size = {}
    for media_dir in MEDIA_DIRS:
        for size, paths in scan(media_dir)[0].items():
            media_by_size.setdefault(size, []).extend(paths)

    print("Comparing candidates...", flush=True)
    pairs, skipped_no_match, already_linked = match_pairs(
        downloads_by_size, media_by_size, compare_fn, downloads_inodes, branches)

    if not pairs:
        print("No duplicates found.")
        if already_linked:
            print(f"Already hardlinked: {already_linked} (skipped without comparing)")
        if WARNINGS:
            sys.exit(f"{WARNINGS} warning(s) - the report above may be incomplete.")
        return

    total_savings = 0
    same_branch_count = 0
    diff_branch_count = 0
    skipped_ambiguous = 0
    failures = []

    for size, dl_path, media_path in pairs:
        try:
            dl_branches = find_branches(dl_path, branches)
            media_branches = find_branches(media_path, branches)
        except (ValueError, OSError) as error:
            failures.append((media_path, str(error)))
            continue

        if not dl_branches or not media_branches:
            failures.append((media_path, "file vanished between scan and action"))
            continue

        # A path present on several branches means mergerfs is masking a stale
        # duplicate. Removing one copy would expose the other, so leave it alone.
        if len(dl_branches) > 1 or len(media_branches) > 1:
            skipped_ambiguous += 1
            print(f"SKIP (exists on multiple branches): {media_path}")
            continue

        dl_branch = dl_branches[0]
        media_branch = media_branches[0]
        dl_branch_path = branch_path(dl_path, dl_branch)
        media_branch_path = branch_path(media_path, media_branch)

        try:
            if os.path.samefile(dl_branch_path, media_branch_path):
                already_linked += 1
                continue
        except OSError as error:
            failures.append((media_path, str(error)))
            continue

        same = dl_branch == media_branch
        if same:
            same_branch_count += 1
            action = "hardlink (same branch)"
        else:
            diff_branch_count += 1
            action = f"move+hardlink ({media_branch} -> {dl_branch})"

        total_savings += size
        print(f"[{size / 1e9:.2f} GB] {action}")
        print(f"  src (downloads): {dl_path}")
        print(f"  dst (media):     {media_path}")

        if not dry_run:
            try:
                if same:
                    link_same_branch(dl_branch_path, media_branch_path)
                else:
                    link_across_branches(
                        dl_branch_path,
                        branch_path(media_path, dl_branch),
                        media_branch_path,
                    )
            except (OSError, RuntimeError) as error:
                failures.append((media_path, str(error)))
                print(f"  FAILED: {error}", file=sys.stderr)

        print()

    print(f"Duplicates found:  {same_branch_count + diff_branch_count}")
    print(f"  Same branch:     {same_branch_count}")
    print(f"  Diff branch:     {diff_branch_count}")
    print(f"Already hardlinked: {already_linked} (no savings available)")
    if skipped_ambiguous:
        print(f"Skipped (multi-branch): {skipped_ambiguous}")
    if skipped_no_match:
        print(f"Skipped (size matched, contents differed): {skipped_no_match}")
    print(f"Space reclaimable: {total_savings / 1e9:.2f} GB")

    if failures:
        print(f"\n{len(failures)} failure(s):", file=sys.stderr)
        for path, error in failures:
            print(f"  {path}: {error}", file=sys.stderr)
    if WARNINGS:
        print(f"\n{WARNINGS} warning(s) - the report above may be incomplete.",
              file=sys.stderr)

    if dry_run:
        print("\nRe-run with --execute to apply changes.")

    # Ambiguous (multi-branch) pairs are unresolved duplicates: goal not met
    # until a consolidate pass clears them, so they must fail the run too.
    if failures or WARNINGS or skipped_ambiguous:
        sys.exit(1)


if __name__ == "__main__":
    main()
