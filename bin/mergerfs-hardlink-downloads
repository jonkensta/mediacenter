#!/usr/bin/env python3
"""
Find duplicate files between the Downloads directory and the media library
(Movies/TV) on a mergerfs pool, and replace the media copy with a hardlink
to the Downloads copy so both paths share a single copy on disk.

Both paths must be on the same underlying branch for a hardlink to work.
If they are on different branches, the media file is moved to the downloads
branch first, then hardlinked.

Usage:
  mergerfs-hardlink-downloads            # dry-run (default, safe)
  mergerfs-hardlink-downloads --execute  # actually make changes

Requires Deluge to be stopped before running with --execute.
"""

import os
import sys
import argparse

MERGED = "/mnt/merged"
DOWNLOADS = os.path.join(MERGED, "Downloads")
MEDIA_DIRS = [os.path.join(MERGED, "Movies"), os.path.join(MERGED, "TV")]
BRANCHES = [f"/mnt/0{i}" for i in range(8)]
MIN_SIZE = 100 * 1024 * 1024  # ignore files smaller than 100MB


def find_branch(merged_path):
    relative = merged_path.removeprefix(MERGED + "/")
    for branch in BRANCHES:
        candidate = os.path.join(branch, relative)
        if os.path.exists(candidate):
            return branch
    raise RuntimeError(f"Could not find branch for {merged_path}")


def branch_path(merged_path, branch):
    relative = merged_path.removeprefix(MERGED + "/")
    return os.path.join(branch, relative)


def scan(path):
    by_size = {}
    for dirpath, _, filenames in os.walk(path):
        for f in filenames:
            fp = os.path.join(dirpath, f)
            try:
                size = os.stat(fp).st_size
                if size >= MIN_SIZE:
                    by_size.setdefault(size, []).append(fp)
            except OSError:
                pass
    return by_size


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--execute", action="store_true", help="Apply changes (default is dry-run)")
    args = parser.parse_args()

    dry_run = not args.execute

    if dry_run:
        print("DRY-RUN mode — no changes will be made. Pass --execute to apply.\n")

    print("Scanning Downloads...", flush=True)
    downloads_by_size = scan(DOWNLOADS)

    print("Scanning Movies and TV...", flush=True)
    media_by_size = {}
    for d in MEDIA_DIRS:
        for size, paths in scan(d).items():
            media_by_size.setdefault(size, []).extend(paths)

    pairs = []
    for size, dl_files in downloads_by_size.items():
        if size in media_by_size:
            for dl_path in dl_files:
                for media_path in media_by_size[size]:
                    pairs.append((size, dl_path, media_path))

    if not pairs:
        print("No duplicates found.")
        return

    total_savings = 0
    same_branch_count = 0
    diff_branch_count = 0

    for size, dl_path, media_path in pairs:
        dl_branch = find_branch(dl_path)
        media_branch = find_branch(media_path)
        dl_branch_path = branch_path(dl_path, dl_branch)
        same = dl_branch == media_branch

        if same:
            same_branch_count += 1
            action = "hardlink (same branch)"
        else:
            diff_branch_count += 1
            action = f"move+hardlink ({media_branch} -> {dl_branch})"

        total_savings += size
        print(f"[{size / 1e9:.2f} GB] {action}")
        print(f"  src (downloads): {dl_path}")
        print(f"  dst (media):     {media_path}")

        if not dry_run:
            media_branch_path = branch_path(media_path, media_branch)
            target_branch_path = branch_path(media_path, dl_branch)

            if not same:
                # Create parent directory on downloads branch if needed
                os.makedirs(os.path.dirname(target_branch_path), exist_ok=True)
                # Create hardlink on the downloads branch
                os.link(dl_branch_path, target_branch_path)
                # Remove the copy from the other branch
                os.remove(media_branch_path)
            else:
                # Atomic replace: hardlink to a temp name, then rename over the media copy
                tmp = media_branch_path + ".hlnk_tmp"
                os.link(dl_branch_path, tmp)
                os.rename(tmp, media_branch_path)

        print()

    print(f"Duplicates found:  {len(pairs)}")
    print(f"  Same branch:     {same_branch_count}")
    print(f"  Diff branch:     {diff_branch_count}")
    print(f"Space reclaimable: {total_savings / 1e9:.2f} GB")
    if dry_run:
        print("\nRe-run with --execute to apply changes.")


if __name__ == "__main__":
    main()
