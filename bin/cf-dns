#!/usr/bin/env python3
"""Manage Cloudflare DNS records for the media server's zone.

Usage:
    cf-dns list
    cf-dns add <name> [target]    # CNAME <name>.jstarr.me -> target
                                  # (default target: home.jstarr.me, DNS-only)

The API token is read from, in order: $CLOUDFLARE_API_TOKEN; the Bitwarden
item dash.cloudflare.com, hidden field dns-edit-token (only when a live
bw-session key exists - a locked vault is silently skipped, never prompted);
/etc/mediaserver/cloudflare-api-token; or the CLOUDFLARE_API_TOKEN line in
/opt/mediaserver/docker-compose.yml (the cloudflare-ddns service, which needs
the token there regardless). It is a scoped token (Zone.DNS:Edit +
Zone.Zone:Read) and never appears on a command line or in output.
"""

import json
import os
import re
import subprocess
import sys
import urllib.request

ZONE = "jstarr.me"
DEFAULT_TARGET = f"home.{ZONE}"
API = "https://api.cloudflare.com/client/v4"
COMPOSE_FILE = "/opt/mediaserver/docker-compose.yml"
TOKEN_FILE = "/etc/mediaserver/cloudflare-api-token"


# Vault item "dash.cloudflare.com"
BW_ITEM_ID = "0ca95f76-af3e-424c-b16c-b37d0021288f"
BW_FIELD = "dns-edit-token"


def token_from_bitwarden():
    """Fetch the token from the vault, or None if locked/unavailable."""
    try:
        sess = subprocess.run(["bw-session"], capture_output=True, text=True, timeout=10)
        if sess.returncode != 0:
            return None
        item = subprocess.run(
            ["bw", "get", "item", BW_ITEM_ID],
            capture_output=True, text=True, timeout=60,
            env={**os.environ, "BW_SESSION": sess.stdout.strip()},
        )
        if item.returncode != 0:
            return None
        for f in json.loads(item.stdout).get("fields") or []:
            if f.get("name") == BW_FIELD and f.get("value"):
                return f["value"]
    except (OSError, subprocess.TimeoutExpired, ValueError):
        pass
    return None


def get_token():
    tok = os.environ.get("CLOUDFLARE_API_TOKEN")
    if tok:
        return tok.strip()
    tok = token_from_bitwarden()
    if tok:
        return tok
    try:
        with open(TOKEN_FILE) as f:
            return f.read().strip()
    except OSError:
        pass
    try:
        with open(COMPOSE_FILE) as f:
            m = re.search(r"CLOUDFLARE_API_TOKEN=(\S+)", f.read())
            if m:
                return m.group(1)
    except OSError:
        pass
    sys.exit(f"cf-dns: no API token in $CLOUDFLARE_API_TOKEN, {TOKEN_FILE}, or {COMPOSE_FILE}")


def api(token, method, path, body=None):
    req = urllib.request.Request(
        f"{API}{path}",
        method=method,
        data=json.dumps(body).encode() if body else None,
        headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.load(resp)
    except urllib.error.HTTPError as e:
        data = json.load(e)
    if not data.get("success"):
        sys.exit(f"cf-dns: API error: {data.get('errors')}")
    return data["result"]


def zone_id(token):
    zones = api(token, "GET", f"/zones?name={ZONE}")
    if not zones:
        sys.exit(f"cf-dns: zone {ZONE} not found (token lacks Zone:Read?)")
    return zones[0]["id"]


def main():
    args = sys.argv[1:]
    if not args or args[0] not in ("list", "add"):
        sys.exit(__doc__.strip())
    token = get_token()
    zid = zone_id(token)

    if args[0] == "list":
        for r in api(token, "GET", f"/zones/{zid}/dns_records?per_page=100"):
            proxied = "proxied" if r.get("proxied") else "dns-only"
            print(f"{r['type']:6s} {r['name']:32s} -> {r['content']} ({proxied})")
        return

    if len(args) < 2:
        sys.exit("cf-dns: add needs a record name")
    name, target = args[1], (args[2] if len(args) > 2 else DEFAULT_TARGET)
    fqdn = name if name.endswith(ZONE) else f"{name}.{ZONE}"
    existing = api(token, "GET", f"/zones/{zid}/dns_records?name={fqdn}")
    if existing:
        r = existing[0]
        sys.exit(f"cf-dns: {fqdn} already exists ({r['type']} -> {r['content']})")
    r = api(token, "POST", f"/zones/{zid}/dns_records",
            {"type": "CNAME", "name": name, "content": target, "ttl": 300, "proxied": False})
    print(f"created {r['type']} {r['name']} -> {r['content']} (dns-only, ttl {r['ttl']})")


if __name__ == "__main__":
    main()
