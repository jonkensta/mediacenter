#!/usr/bin/env python3

"""Script for awaiting block devices with optional power management."""

import argparse
import logging
import pathlib
import signal
import subprocess
import sys
import time

import pyudev

logger = logging.getLogger(__name__)


def present_uuids() -> set[str]:
    """Return the filesystem UUIDs of every block device currently known to udev."""
    context = pyudev.Context()
    return {
        uuid
        for device in context.list_devices(subsystem="block")
        if (uuid := device.properties.get("ID_FS_UUID"))
    }


def power_on_das(relay_device: pathlib.Path):
    """Power on the DAS via relay."""
    logger.info("Powering on DAS via relay at %s", relay_device)
    try:
        subprocess.run(
            ["/usr/local/bin/relay", str(relay_device), "close"],
            check=True,
            capture_output=True,
        )
    except subprocess.CalledProcessError as e:
        logger.error("Failed to power on DAS: %s", e.stderr.decode())
        raise


class DeviceTimeoutError(Exception):
    """Raised when one or more devices did not appear before the timeout."""


def await_block_devices(
    device_uuids: list[str],
    poll_interval: float = 5.0,
    timeout: float = 60.0,
):
    """Wait until every UUID in device_uuids is present, or raise on timeout.

    One udev enumeration serves all UUIDs per poll, and the deadline is measured
    against a monotonic clock so slow enumerations cannot overshoot the timeout.
    """
    outstanding = set(device_uuids)
    deadline = time.monotonic() + timeout

    while True:
        outstanding -= present_uuids()
        if not outstanding:
            logger.info("All devices are available.")
            return

        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise DeviceTimeoutError(
                "Timed out waiting for device(s): " + ", ".join(sorted(outstanding))
            )

        logger.info(
            "Waiting for %d device(s) (%.1fs remaining): %s",
            len(outstanding), remaining, ", ".join(sorted(outstanding)),
        )
        time.sleep(min(poll_interval, remaining))


def main():
    """Await block devices of given UUIDs with optional power management."""

    parser = argparse.ArgumentParser(description=main.__doc__)
    parser.add_argument(
        "uuids",
        nargs="+",
        help="List of UUIDs of devices to await",
    )
    parser.add_argument(
        "--poll-interval",
        type=float,
        default=5,
        help="Poll interval in seconds",
    )
    parser.add_argument(
        "--timeout",
        type=float,
        default=180,
        help="Timeout in seconds",
    )
    parser.add_argument(
        "--relay-device",
        type=pathlib.Path,
        help="USB relay device path (if provided, will power on DAS if devices not available)",
    )
    args = parser.parse_args()

    # If relay device specified, check if we need to power on
    if args.relay_device:
        if set(args.uuids) <= present_uuids():
            logger.info("All devices already available, skipping power on")
        else:
            logger.info("Devices not available, powering on DAS")
            power_on_das(args.relay_device)

    await_block_devices(args.uuids, args.poll_interval, args.timeout)


def _terminate(signum, _frame):
    """Exit non-zero on SIGTERM so systemd sees an interrupted run as failed."""
    logger.info("Received signal %d, exiting...", signum)
    sys.exit(128 + signum)


if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO)
    signal.signal(signal.SIGTERM, _terminate)

    try:
        main()
    except KeyboardInterrupt:
        logger.info("Interrupted.")
        sys.exit(130)
    except Exception as e:  # pylint: disable=broad-except
        logger.error(str(e))
        sys.exit(1)
